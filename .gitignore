# --- Python / backend ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments (in case you ever create one alongside conda)
.venv/
venv/
env/

# SQLite database (generated at runtime — don't commit real data)
*.db
*.sqlite
*.sqlite3

# --- Node / React / Vite frontend ---
node_modules/
frontend/dist/
.vite/
*.local

# npm/yarn logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Environment variables / secrets ---
.env
.env.local
.env.*.local

# --- VSCode ---
.vscode/*
!.vscode/extensions.json

# --- Windows OS files ---
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- macOS (harmless to include even though you're on Windows, in case you ever collaborate) ---
.DS_Store
